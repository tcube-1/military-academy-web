{
  "name": "defence-academy-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "dev:live": "tsx watch --env-file=.env.live src/index.ts",

    "build": "tsc",
    "start": "node dist/index.js",

    "test": "vitest",

    "auth:generate": "auth generate --config ./src/modules/auth/auth.ts",

    "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs push",

    "db:seed": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/seed-master.ts",
    "db:seed:roles": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/seed.ts",

    "live": "cloudflared tunnel run sphereline-dev",

    "start:live": "concurrently -k -n FRONTEND,BACKEND,CLOUDFLARE \"npm --prefix ../frontend run dev:live\" \"npm run dev:live\" \"npm run live\""
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.2",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
